generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum PermissionScope {
  MENU
  ACTION
  API
  DATA
  SENSITIVE_FIELD
  EXPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
  CANCELLED
}

enum CategoryStatus {
  ENABLED
  DISABLED
}

enum ProductStatus {
  DRAFT
  ON_SALE
  OFF_SALE
}

enum ProductType {
  STANDARD
  BUNDLE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum SkuSaleStatus {
  DRAFT
  ON_SALE
  OFF_SALE
}

enum SkuStockMode {
  BATCH
}

enum OrderType {
  STANDARD
}

enum OrderStatus {
  CREATED
  PAID
  ALLOCATING
  WAIT_SHIP
  SHIPPED
  RECEIVED
  COMPLETED
  CANCELLED
  AFTERSALE
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PAYING
  PAID
  PAY_FAILED
  PART_REFUNDED
  REFUNDED
  CLOSED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  ALLOCATING
  WAIT_SHIP
  SHIPPED
  RECEIVED
}

enum OrderAftersaleStatus {
  NONE
  PROCESSING
  COMPLETED
}

enum OrderPriceType {
  GOODS
  PROMOTION
  COUPON
  MEMBER
  POINTS
  FREIGHT
  ADJUSTMENT
  PAYABLE
}

enum PaymentProviderType {
  MOCK
  DISABLED
  WECHAT
  ALIPAY
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
  UNKNOWN
}

enum PaymentTransactionStatus {
  SUCCEEDED
}

enum ShipmentStatus {
  SHIPPED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum ShipmentSyncStatus {
  NOT_CONFIGURED
  PENDING
  SYNCED
  UNKNOWN
}

model User {
  id              BigInt              @id @default(autoincrement())
  publicId        String              @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  nickname        String?             @db.VarChar(30)
  avatarObjectKey String?             @map("avatar_object_key") @db.VarChar(255)
  status          UserStatus          @default(ACTIVE)
  wechatAccounts  UserWechatAccount[]
  sessions        UserSession[]
  addresses       UserAddress[]
  cart            Cart?
  orders          Order[]
  paymentOrders   PaymentOrder[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model UserAddress {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  recipientName String   @map("recipient_name") @db.VarChar(50)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(50)
  city          String   @db.VarChar(50)
  district      String   @db.VarChar(50)
  detail        String   @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, isDefault])
  @@map("user_addresses")
}

model UserWechatAccount {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  openId    String   @unique @map("open_id") @db.VarChar(64)
  unionId   String?  @unique @map("union_id") @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_wechat_accounts")
}

model UserSession {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model Category {
  id        BigInt         @id @default(autoincrement())
  parentId  BigInt?        @map("parent_id")
  code      String         @unique @db.VarChar(64)
  name      String         @db.VarChar(50)
  sortOrder Int            @default(0) @map("sort_order") @db.UnsignedInt
  status    CategoryStatus @default(DISABLED)
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]     @relation("CategoryTree")
  products  Product[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([parentId, status, sortOrder])
  @@map("categories")
}

model Product {
  id          BigInt         @id @default(autoincrement())
  publicId    String         @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  categoryId  BigInt         @map("category_id")
  name        String         @db.VarChar(100)
  subtitle    String?        @db.VarChar(200)
  productType ProductType    @default(STANDARD) @map("product_type")
  content     String         @db.Text
  origin      String?        @db.VarChar(100)
  sortOrder   Int            @default(0) @map("sort_order") @db.UnsignedInt
  status      ProductStatus  @default(DRAFT)
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media       ProductMedia[]
  tags        ProductTag[]
  skus        ProductSku[]
  specs       ProductSpec[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([categoryId, status, sortOrder])
  @@index([status, sortOrder])
  @@map("products")
}

model ProductSku {
  id                  BigInt            @id @default(autoincrement())
  publicId            String            @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  productId           BigInt            @map("product_id")
  skuCode             String            @unique @map("sku_code") @db.VarChar(64)
  skuName             String            @map("sku_name") @db.VarChar(100)
  salePriceCent       Int               @map("sale_price_cent") @db.UnsignedInt
  marketPriceCent     Int?              @map("market_price_cent") @db.UnsignedInt
  weightGram          Int               @map("weight_gram") @db.UnsignedInt
  barcode             String?           @unique @db.VarChar(18)
  saleStatus          SkuSaleStatus     @default(DRAFT) @map("sale_status")
  stockMode           SkuStockMode      @default(BATCH) @map("stock_mode")
  presaleEnabled      Boolean           @default(false) @map("presale_enabled")
  specSignature       String            @map("spec_signature") @db.Char(64)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  specificationValues SkuSpecRelation[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([productId, specSignature])
  @@index([productId, saleStatus])
  @@map("product_skus")
}

model ProductSpec {
  id        BigInt             @id @default(autoincrement())
  productId BigInt             @map("product_id")
  name      String             @db.VarChar(30)
  sortOrder Int                @default(0) @map("sort_order") @db.UnsignedInt
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductSpecValue[]
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_specs")
}

model ProductSpecValue {
  id        BigInt            @id @default(autoincrement())
  specId    BigInt            @map("spec_id")
  value     String            @db.VarChar(50)
  sortOrder Int               @default(0) @map("sort_order") @db.UnsignedInt
  spec      ProductSpec       @relation(fields: [specId], references: [id], onDelete: Cascade)
  skus      SkuSpecRelation[]
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([specId, value])
  @@index([specId, sortOrder])
  @@map("product_spec_values")
}

model SkuSpecRelation {
  skuId       BigInt           @map("sku_id")
  specValueId BigInt           @map("spec_value_id")
  sku         ProductSku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  specValue   ProductSpecValue @relation(fields: [specValueId], references: [id], onDelete: Restrict)

  @@id([skuId, specValueId])
  @@index([specValueId])
  @@map("sku_spec_relations")
}

model ProductMedia {
  id        BigInt           @id @default(autoincrement())
  productId BigInt           @map("product_id")
  type      ProductMediaType
  objectKey String           @map("object_key") @db.VarChar(255)
  altText   String?          @map("alt_text") @db.VarChar(100)
  sortOrder Int              @default(0) @map("sort_order") @db.UnsignedInt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([productId, objectKey])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductTag {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  name      String   @db.VarChar(30)
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_tags")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  publicId  String     @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  userId    BigInt     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        BigInt     @id @default(autoincrement())
  publicId  String     @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  cartId    BigInt     @map("cart_id")
  skuId     BigInt     @map("sku_id")
  quantity  Int        @db.UnsignedTinyInt
  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cartId, skuId])
  @@index([skuId])
  @@map("cart_items")
}

model Order {
  id                BigInt                 @id @default(autoincrement())
  publicId          String                 @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  orderNo           String                 @unique @map("order_no") @db.VarChar(34)
  userId            BigInt                 @map("user_id")
  idempotencyKey    String                 @map("idempotency_key") @db.VarChar(128)
  requestHash       String                 @map("request_hash") @db.Char(64)
  orderType         OrderType              @default(STANDARD) @map("order_type")
  orderStatus       OrderStatus            @default(CREATED) @map("order_status")
  paymentStatus     OrderPaymentStatus     @default(UNPAID) @map("payment_status")
  fulfillmentStatus OrderFulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  aftersaleStatus   OrderAftersaleStatus   @default(NONE) @map("aftersale_status")
  goodsAmountCent   Int                    @map("goods_amount_cent") @db.UnsignedInt
  discountAmountCent Int                   @default(0) @map("discount_amount_cent") @db.UnsignedInt
  freightAmountCent Int                    @map("freight_amount_cent") @db.UnsignedInt
  payableAmountCent Int                    @map("payable_amount_cent") @db.UnsignedInt
  paidAmountCent    Int                    @default(0) @map("paid_amount_cent") @db.UnsignedInt
  paidAt            DateTime?              @map("paid_at")
  shippedAt         DateTime?              @map("shipped_at")
  completedAt       DateTime?              @map("completed_at")
  cancelledAt       DateTime?              @map("cancelled_at")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  address           OrderAddress?
  priceDetails      OrderPriceDetail[]
  statusLogs        OrderStatusLog[]
  paymentOrders     PaymentOrder[]
  shipments         Shipment[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  BigInt     @id @default(autoincrement())
  publicId            String     @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  orderId             BigInt     @map("order_id")
  productId           BigInt     @map("product_id")
  skuId               BigInt     @map("sku_id")
  productNameSnapshot String     @map("product_name_snapshot") @db.VarChar(100)
  skuNameSnapshot     String     @map("sku_name_snapshot") @db.VarChar(100)
  imageSnapshot       String?    @map("image_snapshot") @db.VarChar(255)
  specsSnapshot       Json       @map("specs_snapshot")
  unitPriceCent       Int        @map("unit_price_cent") @db.UnsignedInt
  quantity            Int        @db.UnsignedTinyInt
  discountCent        Int        @default(0) @map("discount_cent") @db.UnsignedInt
  finalAmountCent     Int        @map("final_amount_cent") @db.UnsignedInt
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku                 ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  shipmentItems       ShipmentItem[]
  createdAt           DateTime   @default(now()) @map("created_at")

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

model OrderAddress {
  id            BigInt @id @default(autoincrement())
  orderId       BigInt @unique @map("order_id")
  recipientName String @map("recipient_name") @db.VarChar(50)
  phone         String @db.VarChar(20)
  province      String @db.VarChar(50)
  city          String @db.VarChar(50)
  district      String @db.VarChar(50)
  detail        String @db.VarChar(255)
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderPriceDetail {
  id          BigInt         @id @default(autoincrement())
  orderId     BigInt         @map("order_id")
  type        OrderPriceType
  description String         @db.VarChar(100)
  amountCent  Int            @map("amount_cent") @db.UnsignedInt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_price_details")
}

model OrderStatusLog {
  id         BigInt       @id @default(autoincrement())
  orderId    BigInt       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String       @db.VarChar(200)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model PaymentOrder {
  id                BigInt             @id @default(autoincrement())
  publicId          String             @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  paymentNo         String             @unique @map("payment_no") @db.VarChar(34)
  orderId           BigInt             @map("order_id")
  userId            BigInt             @map("user_id")
  provider          PaymentProviderType
  status            PaymentOrderStatus @default(CREATED)
  amountCent        Int                @map("amount_cent") @db.UnsignedInt
  idempotencyKey    String             @map("idempotency_key") @db.VarChar(128)
  requestHash       String             @map("request_hash") @db.Char(64)
  providerPaymentId String?            @map("provider_payment_id") @db.VarChar(128)
  clientAction      Json?              @map("client_action")
  failureReason     String?            @map("failure_reason") @db.VarChar(64)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  transactions      PaymentTransaction[]

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}

model PaymentTransaction {
  id                BigInt                   @id @default(autoincrement())
  publicId          String                   @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  paymentOrderId    BigInt                   @map("payment_order_id")
  provider          PaymentProviderType
  eventId           String                   @map("event_id") @db.VarChar(128)
  providerPaymentId String                   @map("provider_payment_id") @db.VarChar(128)
  status            PaymentTransactionStatus
  amountCent        Int                      @map("amount_cent") @db.UnsignedInt
  occurredAt        DateTime                 @map("occurred_at")
  paymentOrder      PaymentOrder             @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  createdAt         DateTime                 @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@unique([provider, providerPaymentId])
  @@index([paymentOrderId, createdAt])
  @@map("payment_transactions")
}

model Shipment {
  id                 BigInt             @id @default(autoincrement())
  publicId           String             @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  shipmentNo         String             @unique @map("shipment_no") @db.VarChar(34)
  orderId            BigInt             @map("order_id")
  shippedByAdminId   BigInt             @map("shipped_by_admin_id")
  idempotencyKey     String             @map("idempotency_key") @db.VarChar(128)
  requestHash        String             @map("request_hash") @db.Char(64)
  status             ShipmentStatus     @default(SHIPPED)
  syncStatus         ShipmentSyncStatus @default(NOT_CONFIGURED) @map("sync_status")
  carrierCode        String             @map("carrier_code") @db.VarChar(32)
  carrierName        String             @map("carrier_name") @db.VarChar(50)
  trackingNo         String             @map("tracking_no") @db.VarChar(64)
  shippedAt          DateTime           @default(now()) @map("shipped_at")
  deliveredAt        DateTime?          @map("delivered_at")
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippedByAdmin     AdminUser          @relation(fields: [shippedByAdminId], references: [id], onDelete: Restrict)
  items              ShipmentItem[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([orderId, idempotencyKey])
  @@unique([carrierCode, trackingNo])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([shippedByAdminId])
  @@map("shipments")
}

model ShipmentItem {
  id          BigInt    @id @default(autoincrement())
  shipmentId  BigInt    @map("shipment_id")
  orderItemId BigInt    @map("order_item_id")
  quantity    Int       @db.UnsignedTinyInt
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

model AdminUser {
  id           BigInt          @id @default(autoincrement())
  username     String          @unique @db.VarChar(64)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  displayName  String          @map("display_name") @db.VarChar(100)
  status       AdminUserStatus @default(ACTIVE)
  roles        AdminUserRole[]
  shipments    Shipment[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Role {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(100)
  isSystem    Boolean          @default(false) @map("is_system")
  users       AdminUserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id        BigInt           @id @default(autoincrement())
  code      String           @unique @db.VarChar(128)
  name      String           @db.VarChar(100)
  scope     PermissionScope
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model AdminUserRole {
  adminUserId BigInt    @map("admin_user_id")
  roleId      BigInt    @map("role_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
