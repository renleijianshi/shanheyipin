generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum PermissionScope {
  MENU
  ACTION
  API
  DATA
  SENSITIVE_FIELD
  EXPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
  CANCELLED
}

enum CategoryStatus {
  ENABLED
  DISABLED
}

enum ProductStatus {
  DRAFT
  ON_SALE
  OFF_SALE
}

enum ProductType {
  STANDARD
  BUNDLE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model User {
  id              BigInt              @id @default(autoincrement())
  publicId        String              @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  nickname        String?             @db.VarChar(30)
  avatarObjectKey String?             @map("avatar_object_key") @db.VarChar(255)
  status          UserStatus          @default(ACTIVE)
  wechatAccounts  UserWechatAccount[]
  sessions        UserSession[]
  addresses       UserAddress[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model UserAddress {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  recipientName String   @map("recipient_name") @db.VarChar(50)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(50)
  city          String   @db.VarChar(50)
  district      String   @db.VarChar(50)
  detail        String   @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, isDefault])
  @@map("user_addresses")
}

model UserWechatAccount {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  openId    String   @unique @map("open_id") @db.VarChar(64)
  unionId   String?  @unique @map("union_id") @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_wechat_accounts")
}

model UserSession {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model Category {
  id        BigInt         @id @default(autoincrement())
  parentId  BigInt?        @map("parent_id")
  code      String         @unique @db.VarChar(64)
  name      String         @db.VarChar(50)
  sortOrder Int            @default(0) @map("sort_order") @db.UnsignedInt
  status    CategoryStatus @default(DISABLED)
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]     @relation("CategoryTree")
  products  Product[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([parentId, status, sortOrder])
  @@map("categories")
}

model Product {
  id          BigInt        @id @default(autoincrement())
  publicId    String        @unique @default(uuid()) @map("public_id") @db.VarChar(36)
  categoryId  BigInt        @map("category_id")
  name        String        @db.VarChar(100)
  subtitle    String?       @db.VarChar(200)
  productType ProductType   @default(STANDARD) @map("product_type")
  content     String        @db.Text
  origin      String?       @db.VarChar(100)
  sortOrder   Int           @default(0) @map("sort_order") @db.UnsignedInt
  status      ProductStatus @default(DRAFT)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media       ProductMedia[]
  tags        ProductTag[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([categoryId, status, sortOrder])
  @@index([status, sortOrder])
  @@map("products")
}

model ProductMedia {
  id        BigInt           @id @default(autoincrement())
  productId BigInt           @map("product_id")
  type      ProductMediaType
  objectKey String           @map("object_key") @db.VarChar(255)
  altText   String?          @map("alt_text") @db.VarChar(100)
  sortOrder Int              @default(0) @map("sort_order") @db.UnsignedInt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([productId, objectKey])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductTag {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  name      String   @db.VarChar(30)
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_tags")
}

model AdminUser {
  id           BigInt          @id @default(autoincrement())
  username     String          @unique @db.VarChar(64)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  displayName  String          @map("display_name") @db.VarChar(100)
  status       AdminUserStatus @default(ACTIVE)
  roles        AdminUserRole[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Role {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(100)
  isSystem    Boolean          @default(false) @map("is_system")
  users       AdminUserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id        BigInt           @id @default(autoincrement())
  code      String           @unique @db.VarChar(128)
  name      String           @db.VarChar(100)
  scope     PermissionScope
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model AdminUserRole {
  adminUserId BigInt    @map("admin_user_id")
  roleId      BigInt    @map("role_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
