{
  "name": "shanheyipin",
  "version": "0.1.0",
  "private": true,
  "description": "山禾颐品小程序、管理后台与 API monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "lint": "eslint .",
    "postinstall": "npm run db:generate",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prisma": "6.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  }
}
